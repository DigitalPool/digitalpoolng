// Cloudflare Workers config.
// Cloudflare runs `npm run build`, then `npx wrangler deploy`, which uploads ./dist as the
// site and worker/index.js as the small server that sends contact-form briefs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digitalpoolng",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // only /api/* runs the Worker; everything else is served straight from ./dist
    "run_worker_first": ["/api/*"],
    // /work serves work.html, /about serves about.html, etc.
    "html_handling": "auto-trailing-slash",
    // unknown URLs show our 404.html
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
